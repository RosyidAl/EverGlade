# EverGlade Environment Configuration
# Copy this file to .env and update the values for your local setup.
# .env is gitignored and will NOT be committed.

# Application Host Port Binding (Default 8085 to avoid collision with code-server on 8080)
APP_PORT=8085

# MySQL Database Configuration
DB_URL=jdbc:mysql://localhost:3306/db_manajemen_tanaman
DB_NAME=db_manajemen_tanaman
DB_USER=root
DB_PASSWORD=your_mysql_password_here
