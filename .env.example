# EverGlade Environment Configuration
# Salin file ini menjadi .env dan sesuaikan dengan konfigurasi Anda.
# File .env di-ignore oleh Git dan tidak akan ter-commit.

# Port aplikasi di host (Default 8085)
APP_PORT=8085

# ========================================================
# OPSI A: KONEKSI KE AZURE MYSQL (Untuk VPS Deployment)
# ========================================================
# Profil 'azure' menghubungkan aplikasi langsung ke Azure Database for MySQL
SPRING_PROFILES_ACTIVE=azure
DB_URL=jdbc:mysql://mysql-project.mysql.database.azure.com:3306/db_manajemen_tanaman?sslMode=REQUIRED&enabledTLSProtocols=TLSv1.2,TLSv1.3&connectTimeout=30000&nullCatalogMeansCurrent=true&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USER=your_azure_user
DB_PASSWORD=your_azure_password

# ========================================================
# OPSI B: KONEKSI KE MYSQL LOKAL (Untuk Development Teman)
# ========================================================
# Jika teman ingin develop menggunakan MySQL lokal di laptopnya:
# 1. Comment baris Opsi A di atas dan un-comment baris Opsi B di bawah.
# 2. Jika menjalankan aplikasi via IDE / Maven (mvnw spring-boot:run):
#    Aplikasi otomatis menggunakan profil default (localhost:3306).
# 3. Jika teman ingin menjalankan DB MySQL lokal lewat Docker:
#    Jalankan: docker compose --profile local up -d db
#
# SPRING_PROFILES_ACTIVE=default
# DB_URL=jdbc:mysql://localhost:3306/db_manajemen_tanaman?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Jakarta
# DB_USER=root
# DB_PASSWORD=your_local_password
# LOCAL_DB_PASSWORD=your_local_password
# DB_NAME=db_manajemen_tanaman
